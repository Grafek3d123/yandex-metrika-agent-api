# Скопируйте в .env и заполните. .env в .gitignore — никогда не коммитить.
# === Собственный OAuth-клиент Яндекса (OAuth client) ===
# Регистрация: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Device flow — CLI-авторизация без секрета и без redirect URI (рекомендуется).
# Включите, если клиент зарегистрирован с типом "Устройство".
# https://oauth.yandex.ru/device/verify
YANDEX_DEVICE_FLOW=true

# Redirect URI должен совпадать со значением у клиента (для browser-flow).
# Если device flow включён, это поле можно оставить по умолчанию.
YANDEX_REDIRECT_URI=http://localhost:8765/callback

# === Scopes OAuth-клиента Метрики ===
# Полный список скоупов: https://yandex.ru/dev/metrika/ru/intro/authorization
#   metrika:read     — чтение счётчиков и статистики (Management + Reports API)
#   metrika:write    — изменение объектов Метрики (цели, настройки счётчика)
#   metrika:logs     — Logs API (не нужен для MVP)
# Отдельных scope'ов вида "read:metrika:manage" / "read:metrika:logs" НЕ существует.
#   metrika:manage — API управления (цели, настройки счётчика)
#   metrika:logs   — Logs API (для MVP не требуется)

# === Хранилище токенов (token storage) ===
# AES-GCM ключ: 64 hex символа. Сгенерировать:  python -m yandex_metrika_agent.tools genkey
# Никогда не используйте продакшн-ключ из репозитория.
METRIKA_TOKEN_KEY=

# Директория с зашифрованными токенами (по умолчанию: ~/.metrika-agent/tokens)
METRIKA_TOKEN_DIR=

# === Runtime ===
# production | sandbox
METRIKA_ENV=production
# HTTP timeout, с
METRIKA_HTTP_TIMEOUT=30
# число повторов при 5xx / 429
METRIKA_HTTP_RETRIES=3
# INFO | DEBUG (DEBUG анонимизирует чувствительные данные)
METRIKA_LOG_LEVEL=INFO
